#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <12>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为
    // 左右滚动编码器行为
    // セレクト上下（↑/↓）用エンコーダ

    select_updown_encoder: select_updown_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp DOWN_ARROW>, <&kp UP_ARROW>;

        tap-ms = <80>;
    };

    TD1: TD1 {
        compatible = "zmk,behavior-tap-dance";
        label = "TD1";
        #binding-cells = <0>;
        bindings = <&to 0>, <&to 1>, <&to 2>;
    };

    TD2: TD2 {
        compatible = "zmk,behavior-tap-dance";
        label = "TD2";
        #binding-cells = <0>;
        bindings = <&to 0>, <&to 3>, <&to 4>;
    };

    TD3: TD3 {
        compatible = "zmk,behavior-tap-dance";
        label = "TD3";
        #binding-cells = <0>;
        bindings = <&kp LANG1>, <&kp LANGUAGE_2>;
    };

    UpDownScrl: UpDownScrl {
        compatible = "zmk,behavior-sensor-rotate";
        label = "UPDOWNSCRL";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

        tap-ms = <80>;
    };

    HorisontalScrl: HorisontalScrl {
        compatible = "zmk,behavior-sensor-rotate";
        label = "HORISONTALSCRL";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <80>;
    };

    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&TD3              &kp N1        &kp N2        &kp N3     &kp N4  &kp N5  &kp N6     &kp N7     &kp N8     &kp N9          &kp N0          &kp BACKSPACE
&kp ESC           &kp Q         &kp W         &kp E      &kp R   &kp T   &kp Y      &kp U      &kp I      &kp O           &kp P           &kp DELETE
&kp TAB           &kp A         &kp S         &kp D      &kp F   &kp G   &kp H      &kp J      &kp K      &kp L           &kp SEMI        &kp MINUS
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C      &kp V   &kp B   &kp N      &kp M      &kp COMMA  &kp DOT         &kp UP_ARROW    &kp FSLH
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &kp SPACE  &TD1    &TD2    &mkp LCLK  &mkp RCLK  &kp ENTER  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW
            >;

            sensor-bindings = <&select_updown_encoder>, <&UpDownScrl>;
        };

        F_layers {
            bindings = <
&trans  &kp F1           &kp F2           &kp F3           &kp F4         &kp F5     &kp F6           &kp F7       &kp F8                 &kp F9            &kp F10            &trans
&trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp DOT        &kp ASTRK  &kp AMPERSAND    &kp LPAR     &kp RIGHT_PARENTHESIS  &kp F11           &kp F12            &kp NON_US_BSLH
&trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp COLON      &kp PLUS   &kp DOLLAR       &kp PERCENT  &kp CARET              &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp TILDE
&trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DIVIDE  &kp UNDER  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH               &kp PRINTSCREEN   &trans             &kp SINGLE_QUOTE
&trans  &kp KP_N0        &trans           &trans           &trans         &trans     &trans           &trans       &trans                 &trans            &trans             &trans
            >;

            sensor-bindings = <&none>, <&select_updown_encoder>;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans        &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&none>, <&select_updown_encoder>;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&none>, <&select_updown_encoder>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&none>, <&select_updown_encoder>;
        };
    };
};
